<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.ytbrowser.viewer.SpeedAdjustedVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- Nút chuyển tốc độ phát - vị trí góc phải trên, cùng kiểu toạ độ (44dp vuông, cách trên
         8dp, cách phải ~26dp) với ô vuông tải xuống ở app xem YouTube (xem
         addDownloadOverlayButton() trong repo Y-utubecuatoi) để quen mắt, dễ bấm bằng ngón cái. -->
    <TextView
        android:id="@+id/btnSpeed"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/bg_speed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="2x"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</FrameLayout>
